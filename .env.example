# ---------- App ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma separated list. Use * only in local dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Database ----------
# Matches docker-compose.yml defaults
DATABASE_URL="postgresql://findmystuff:findmystuff@localhost:5433/findmystuff?schema=public"

# ---------- Auth ----------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- Terms & Conditions ----------
# Bump this when the T&C text changes; users are re-prompted automatically.
TERMS_VERSION=2026-09-01

# ---------- Media ----------
MEDIA_DRIVER=local
MEDIA_LOCAL_PATH=./storage/media
# Max decoded image size in bytes (default 8MB)
MEDIA_MAX_BYTES=8388608
MEDIA_THUMBNAIL_WIDTH=320

# ---------- Rate limiting ----------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL_SECONDS=300
AUTH_THROTTLE_LIMIT=10
