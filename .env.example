# ---------- App ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma separated list. Use * only in local dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Database ----------
# Local Docker Postgres (docker-compose.yml). Locally there is no connection
# pooler, so DIRECT_URL is the same value.
DATABASE_URL="postgresql://findmystuff:findmystuff@localhost:5433/findmystuff?schema=public"
DIRECT_URL="postgresql://findmystuff:findmystuff@localhost:5433/findmystuff?schema=public"

# --- Hosted Postgres (Neon) ---
# Neon gives you a POOLED host (contains "-pooler") and a DIRECT host (the same
# name without "-pooler"). The app uses the pooled one; migrations need the
# direct one, so set both.
#
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=5"
#   DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
#
# Three edits to make to the string Neon shows you:
#   - drop "&channel_binding=require"  (Prisma's driver does not accept it)
#   - add "&pgbouncer=true" to the POOLED url only
#   - add "&connection_limit=5" to the POOLED url only — Prisma's own default
#     is (CPU cores * 2 + 1), each one real memory; Neon's pooler already
#     pools underneath, so Prisma opening a large pool of its own on top is
#     pure waste on a memory-constrained free container.

# ---------- Auth ----------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- Terms & Conditions ----------
# Bump this when the T&C text changes; users are re-prompted automatically.
TERMS_VERSION=2026-09-01

# ---------- Media ----------
# Where uploaded images are stored:
#   local — files on this machine's disk (./storage/media). Local dev only:
#           Render's disk is wiped on every deploy, restart and wake from sleep.
#   s3    — any S3-compatible object storage (Neon object storage, AWS S3, R2).
MEDIA_DRIVER=local
MEDIA_LOCAL_PATH=./storage/media
# Max decoded image size in bytes (default 8MB)
MEDIA_MAX_BYTES=8388608
MEDIA_THUMBNAIL_WIDTH=320

# ---------- Object storage (only read when MEDIA_DRIVER=s3) ----------
# Copy these from your storage provider (Neon: project -> Object storage).
# The AWS_* names are the standard ones the AWS SDK reads.
MEDIA_S3_BUCKET=assets
# Folder inside the bucket that images go under.
MEDIA_S3_PREFIX=media
AWS_REGION=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Most S3-compatible providers need path-style URLs. Set to false only for AWS S3
# buckets that require virtual-hosted style.
MEDIA_S3_FORCE_PATH_STYLE=true

# ---------- Rate limiting ----------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
AUTH_THROTTLE_TTL_SECONDS=300
AUTH_THROTTLE_LIMIT=10

# ---------- Idempotency ----------
# How long an Idempotency-Key is remembered. A retry with the same key inside
# this window replays the stored response; after it, the key runs as new.
IDEMPOTENCY_KEY_TTL_HOURS=24
